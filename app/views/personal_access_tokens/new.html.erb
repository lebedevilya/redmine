<h2><%= l(:label_personal_access_token_new) %></h2>

<%= labelled_form_for @token, :url => personal_access_tokens_path, :method => :post do |f| %>
  <%= error_messages_for @token %>
  <div class="box tabular">
    <p><%= f.text_field :name, :required => true, :size => 40 %></p>
    <p><%= f.date_field :expires_on, :required => true %></p>
  </div>
  <fieldset class="box">
    <legend><%= l(:label_personal_access_token_scopes) %></legend>
    <p class="info"><%= l(:text_personal_access_token_scopes_info) %></p>
    <% grouped_permissions.each do |mod, permissions| %>
      <fieldset>
        <legend><%= mod.blank? ? l(:label_general) : l_or_humanize(mod, :prefix => 'project_module_') %></legend>
        <% permissions.each do |permission| %>
          <label>
            <%= check_box_tag 'personal_access_token[scopes][]', permission.name, false,
                  :id => "pat_scope_#{permission.name}" %>
            <%= l_or_humanize(permission.name, :prefix => 'permission_') %>
          </label><br />
        <% end %>
      </fieldset>
    <% end %>
  </fieldset>
  <%= submit_tag l(:button_create) %>
<% end %>
